# GitHub Configuration
VITE_GITHUB_OWNER=zacharysalvatore
VITE_GITHUB_REPO=zacharysalvatore.github.io

# Gitalk OAuth App (https://github.com/settings/applications/new)
VITE_GITALK_CLIENT_ID=
VITE_GITALK_CLIENT_SECRET=

# 站点域名 —— canonical / og:url / sitemap.xml 的唯一来源
# 若使用自定义域名，需与仓库根目录 CNAME 文件一致；默认使用 GitHub Pages 地址。
VITE_SITE_URL=https://zacharysalvatore.github.io

# 可选：自建后端 Worker 基址（浏览量 / 友链 / GitHub 代理 / Gitalk OAuth 等）
# 留空时，GitHub API 自动直连 https://api.github.com，依赖私有后端的功能将自动降级。
VITE_BACKEND_BASE=

# 后端域名池（可选，仅在自建多个 Worker 时启用）
VITE_BACKEND_POOL_ENABLED=false
# VITE_BACKEND_POOL=

# 以下端点在配置了 VITE_BACKEND_BASE 时会自动派生，通常无需单独配置
# VITE_GITHUB_API_BASE=
# VITE_GITHUB_USER_API=
# VITE_CLINE_API_BASE=
# VITE_CLINE_ALL_API=
# VITE_API_BASE=
